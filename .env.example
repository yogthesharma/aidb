# Copy to `.env`. AIDB reads these from the environment; they are never stored
# in the SQLite file. `pnpm example:support` and `pnpm example:chat` load this file.
#
# Official Kimi docs use MOONSHOT_API_KEY and
# POST https://api.moonshot.ai/v1/chat/completions

MOONSHOT_API_KEY=
# KIMI_API_KEY=

AIDB_LLM_MODEL=kimi-k2.5
# Optional embeddings for Knowledge search. Default is fake 256-d in the chat space.
# OPENAI_API_KEY=
# AIDB_EMBED_MODEL=text-embedding-3-small
# AIDB_EMBED_DIMS=256
# Kimi-K2.5/K2.6 fix temperature (0.6 instant / 1.0 thinking). Do not set this for Kimi.
# AIDB_LLM_TEMPERATURE=0.3
# AIDB_KIMI_THINKING=1
# AIDB_KIMI_BASE_URL=https://api.moonshot.cn/v1
